# Copy to .env and fill in. Never commit .env.

PORT=5000

# MongoDB connection string (MongoDB Atlas free tier works).
# For a quick local try without a database, set STORAGE=memory instead.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/ai-code-editor
# STORAGE=memory

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: raises GitHub's download limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# Comma-separated frontend URLs allowed to call this API in production.
CORS_ORIGINS=http://localhost:5173
